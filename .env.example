# steady - environment placeholders
# Copy this file to .env and fill in real values once Supabase is wired up.
# Vite only exposes VITE_-prefixed vars to client code (src/config/supabase.ts).

# Supabase project (shared with bloom). Client-facing values:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Server/CI only - used by the RLS test suite (tests/rls-security.test.ts)
# against a LOCAL Supabase stack. NEVER ship this value to the client.
# SUPABASE_SERVICE_ROLE_KEY=
